// The landing page on Cloudflare: deploy from this folder with `npx wrangler deploy`.
// Live at https://aina.ai.id (and www), plus https://aina-landing.faisalmashuri16.workers.dev.
// The old https://badi-landing… address redirects here (a separate redirect-only Worker).
// Static assets, plus worker.js for /api/*, which it hands to the badi-cloud Worker (service binding API).
{
  "name": "aina-landing",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only these run the Worker: /api/*, the account pages, and the pages search engines index
    // (it sends www to the bare domain for all of them). Everything else is served straight from the
    // assets, and an unknown path gets 404.html.
    "run_worker_first": ["/", "/playground", "/api/*", "/masuk", "/langganan", "/terima-kasih"],
    "not_found_handling": "404-page"
  },
  "services": [
    { "binding": "API", "service": "badi-cloud" }
  ],
  // Page views and installer downloads (worker.js; queries in docs/analytics.md of aina-backend).
  // Secret VISITOR_SALT (wrangler secret put VISITOR_SALT) salts the daily visitor hash.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "aina_events" }
  ],
  // Custom domains: Cloudflare creates the DNS records and certificates itself (the zone must be on Cloudflare).
  "routes": [
    { "pattern": "aina.ai.id", "custom_domain": true },
    { "pattern": "www.aina.ai.id", "custom_domain": true }
  ]
}
